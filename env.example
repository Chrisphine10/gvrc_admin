# Django Settings
SECRET_KEY=your_secret_key_here_make_it_long_and_random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Google Maps API Configuration
# Optional: only needed if Map Settings is set to Google Maps.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Email Configuration (if using SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# Redis Configuration (for Channels/Chat)
REDIS_URL=redis://localhost:6379/0

# Static and Media Files
STATIC_URL=/static/
MEDIA_URL=/media/

# Security Settings
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000


# Bulk SMS through the Intelli-Wealth account on Bonga SMS (same account as
# IntelliCash, sender ID INTELLIWLTH). Values saved under Administration >
# SMS Settings override these. Copy them from /var/www/intellicash/.env.
BONGA_SMS_CLIENT_ID=
BONGA_SMS_API_KEY=
BONGA_SMS_API_SECRET=
BONGA_SMS_SERVICE_ID=
# BONGA_SMS_ENDPOINT=http://167.172.14.50:4002/v1/send-sms
# false = every SMS stays queued (staging, demos). Default true.
ENABLE_SMS_NETWORK_CALLS=true
